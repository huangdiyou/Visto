{
  "name": "visto",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first media delivery and review platform.",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @review-studio/web",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,css,json}\" package.json",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,css,json}\" package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "yaml": "2.9.0"
  }
}
